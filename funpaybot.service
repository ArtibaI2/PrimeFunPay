[Unit]
Description=FunPay Automation Bot Service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/FunPayBot
ExecStart=/root/FunPayBot/.venv/bin/python main.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
Environment="PYTHONUNBUFFERED=1"

[Install]
WantedBy=multi-user.target
