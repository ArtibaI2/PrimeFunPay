# ==========================================
# FunPay Bot Configuration
# ==========================================

# FunPay Account Settings
# Golden Key - Cookie value 'golden_key' from funpay.com
FUNPAY_GOLDEN_KEY=your_golden_key_here
FUNPAY_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36
FUNPAY_PROXY= # Example: http://user:pass@ip:port or socks5://ip:port

# Telegram Bot Settings (Optional, for admin management and alerts)
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
# Telegram Admin User IDs (comma-separated if multiple, e.g.: 12345678,87654321)
TELEGRAM_ADMIN_IDS=12345678

# Automation Modules (True / False)
ENABLE_AUTO_DELIVERY=True
ENABLE_AUTO_RAISE=True
ENABLE_AUTO_RESPONSE=True
ENABLE_STOCK_SYNC=True

# Auto-Raise Settings
# Interval in seconds between lot raises (FunPay minimum is ~2 hours / 7200s)
AUTO_RAISE_INTERVAL=7200

# Auto-Response Settings
AUTO_RESPONSE_GREETING="Здравствуйте! Спасибо за обращение. Если у вас возник вопрос по заказу, пожалуйста, уточните детали."
AUTO_RESPONSE_AFTER_PURCHASE="Спасибо за покупку! Ваш заказ обрабатывается. Пожалуйста, подтвердите заказ после проверки."

# Database Path
DATABASE_URL=sqlite+aiosqlite:///storage/sqlite.db
LOG_LEVEL=INFO
